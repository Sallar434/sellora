# ---- Core ----
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
# SQLite for dev. For Postgres: run `npm run db:pg` once, then e.g. postgresql://vendom:vendom@localhost:5432/vendom
DATABASE_URL="file:./dev.db"
CORS_ORIGINS=*                     # comma list in prod, e.g. https://admin.yourshop.com
# REQUIRED in production (server refuses to start with dev defaults). Generate: openssl rand -hex 32
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ENCRYPTION_KEY=                     # 64 hex chars, or any random secret of 32+ chars - encrypts app credentials / bank details at rest
WEBHOOK_SIGNING_SECRET=whsec_dev    # signs outgoing webhooks + verifies mock incoming ones

# ---- VendOm Pay ----
PLATFORM_FEE_BPS=250                # 2.5% default; per-store override via admin
ESCROW_AUTO_RELEASE_DAYS=7
PAYMENT_PROVIDER=mock               # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Jobs (optional; in-process queue if empty) ----
REDIS_URL=                          # redis://localhost:6379 -> BullMQ (npm i bullmq ioredis)

# ---- Email / SMS (mock/log if empty) ----
SMTP_URL=                           # smtp://user:pass@smtp.host:587
MAIL_FROM="VendOm <no-reply@vendom.app>"
SMS_PROVIDER=mock                   # mock | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- AI (OpenAI-compatible; template fallback if empty) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Storage ----
STORAGE_DRIVER=local                # local | s3 (npm i @aws-sdk/client-s3)
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---- FX ----
FX_PROVIDER=static                  # static | http
FX_API_URL=                         # e.g. https://open.er-api.com/v6/latest/{base}

# --- AI provider (DeepSeek is default when DEEPSEEK_API_KEY is set; otherwise LLM_* OpenAI-compatible; otherwise built-in mock templates)
LLM_PROVIDER=            # deepseek | openai | mock (auto if blank)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash   # or deepseek-v4-pro
DEEPSEEK_THINKING=0             # 1 = thinking mode (slower, more output tokens)
# Speech-to-text: 'browser' = Web Speech API in the dashboard (free). Set 'http' + STT_URL/STT_API_KEY for a server STT (e.g. Whisper-compatible)
STT_PROVIDER=browser
STT_URL=
STT_API_KEY=
# SEO integrations (optional)
INDEXNOW_KEY=
RANK_API_URL=
RANK_API_KEY=
PAGESPEED_API_KEY=
COMPETITOR_FETCH=0

# --- VendOm AI assistant: three providers, chosen by plan (see docs/AI-models.md)
ANTHROPIC_API_KEY=              # Claude (Advanced + Enterprise by default)
ANTHROPIC_MODEL=claude-opus-5-5
KIMI_API_KEY=                   # Moonshot Kimi (Grow by default)
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6            # check the current model id on platform.moonshot.ai
# DEEPSEEK_API_KEY above powers Basic by default
AI_TIER_BASIC=deepseek
AI_TIER_GROW=kimi
AI_TIER_ADVANCED=claude
AI_TIER_ENTERPRISE=claude
AI_CREDITS_DEEPSEEK=1           # AI credits per assistant reply
AI_CREDITS_KIMI=2
AI_CREDITS_CLAUDE=5

# --- VendOm Pay Protection timings (days)
SHIP_BY_DAYS=5                  # protected order not shipped by then → buyer refunded in full
NOT_RECEIVED_RESPONSE_DAYS=3    # seller's time to answer a "not received" report
PAYPAL_CLIENT_ID=               # shows PayPal at checkout when set
