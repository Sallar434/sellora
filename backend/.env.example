# ---- Core ----
NODE_ENV=development
PORT=4000
PUBLIC_URL=http://localhost:4000
# SQLite for dev. For Postgres: run `npm run db:pg` once, then e.g. postgresql://sellora:sellora@localhost:5432/sellora
DATABASE_URL="file:./dev.db"
CORS_ORIGINS=*                     # comma list in prod, e.g. https://admin.yourshop.com
# REQUIRED in production (server refuses to start with dev defaults). Generate: openssl rand -hex 32
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
ENCRYPTION_KEY=                     # 64 hex chars (32 bytes) - encrypts app credentials / bank details at rest
WEBHOOK_SIGNING_SECRET=whsec_dev    # signs outgoing webhooks + verifies mock incoming ones

# ---- Sellora Pay ----
PLATFORM_FEE_BPS=250                # 2.5% default; per-store override via admin
ESCROW_AUTO_RELEASE_DAYS=7
PAYMENT_PROVIDER=mock               # mock | stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Jobs (optional; in-process queue if empty) ----
REDIS_URL=                          # redis://localhost:6379 -> BullMQ (npm i bullmq ioredis)

# ---- Email / SMS (mock/log if empty) ----
SMTP_URL=                           # smtp://user:pass@smtp.host:587
MAIL_FROM="Sellora <no-reply@sellora.app>"
SMS_PROVIDER=mock                   # mock | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- AI (OpenAI-compatible; template fallback if empty) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- Storage ----
STORAGE_DRIVER=local                # local | s3 (npm i @aws-sdk/client-s3)
UPLOAD_DIR=uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# ---- FX ----
FX_PROVIDER=static                  # static | http
FX_API_URL=                         # e.g. https://open.er-api.com/v6/latest/{base}

# --- AI provider (DeepSeek is default when DEEPSEEK_API_KEY is set; otherwise LLM_* OpenAI-compatible; otherwise built-in mock templates)
LLM_PROVIDER=            # deepseek | openai | mock (auto if blank)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash   # or deepseek-v4-pro
DEEPSEEK_THINKING=0             # 1 = thinking mode (slower, more output tokens)
# Speech-to-text: 'browser' = Web Speech API in the dashboard (free). Set 'http' + STT_URL/STT_API_KEY for a server STT (e.g. Whisper-compatible)
STT_PROVIDER=browser
STT_URL=
STT_API_KEY=
# SEO integrations (optional)
INDEXNOW_KEY=
RANK_API_URL=
RANK_API_KEY=
PAGESPEED_API_KEY=
COMPETITOR_FETCH=0
