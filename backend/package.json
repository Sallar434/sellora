{
  "name": "sellora-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node dist/server.js",
    "db:dev": "prisma db push --skip-generate && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:pg": "node scripts/use-postgres.js && prisma generate",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "otplib": "^12.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "eslint": "^9.39.5",
    "prisma": "6.16.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "prisma@6.16.2": true,
    "@prisma/engines@6.16.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.20.0"
  }
}
