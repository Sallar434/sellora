{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "frontend",
  "rewrites": [
    {
      "source": "/",
      "destination": "/vendom.html"
    }
  ],
  "redirects": [
    {
      "source": "/sellora.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/sellora-connected.html",
      "destination": "/vendom-connected.html",
      "permanent": true
    }
  ]
}
